---
import "../styles/global.css";
import content from "../data/about.json";
import Navbar from "../components/Navbar.astro";
import TeamSection from "../components/TeamSection.astro";
import FAQSection from "../components/FAQSection.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us | 4K Projects</title>
    <!-- Preload primary display font to prevent layout shift during diff test -->
    <link rel="preload" href="/fonts/source-serif-4.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-[var(--color-page)] text-[var(--color-text-primary)] antialiased">
    <Navbar />

    <main>
      <!-- HERO SECTION -->
      <section class="page-container pt-[140px] md:pt-[180px] lg:pt-[200px] pb-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-baseline">
          <h1 class="hero-title lg:col-span-5">{content.hero.title}</h1>
          <p class="hero-subtitle lg:col-span-7 text-[var(--color-text-primary)] max-w-2xl leading-[1.3] text-[15px] md:text-[17px] lg:text-[18px]">
            {content.hero.lead}
          </p>
        </div>

        <div class="mt-10 md:mt-14 w-full overflow-hidden rounded-[14px]">
          <img
            src={content.hero.heroImage}
            alt={content.hero.heroImageAlt}
            width="1380"
            height="760"
            loading="eager"
            decoding="async"
            class="w-full object-cover aspect-[16/9] md:aspect-[2/1] rounded-[14px]"
          />
        </div>
      </section>

      <!-- OUR STORY SECTION (Solid Black) -->
      <section class="bg-black text-[#f2f2f0] py-16 md:py-24 lg:py-32 mt-12 md:mt-16">
        <div class="page-container grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="text-[38px] md:text-[48px] lg:text-[56px] font-serif leading-none tracking-tight">
              {content.story.title}
            </h2>
          </div>
          <div class="lg:col-span-8 flex flex-col gap-6 md:gap-7 text-[14px] md:text-[15px] lg:text-[16px] leading-[1.4] text-neutral-300 max-w-2xl">
            {content.story.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </div>
      </section>

      <!-- THE 4K TEAM -->
      <TeamSection data={content.team} />

      <!-- FAQ SECTION -->
      <FAQSection questions={content.faq} />
    </main>

    <!-- FOOTER -->
    <Footer />
  </body>
</html>