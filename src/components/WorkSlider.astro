---
// src/components/WorkSlider.astro
interface Props {
  slides?: string[];
}

const {
  slides = [
    "/images/aboutHeroAssets/about-asset-1.webp",
    "/images/aboutHeroAssets/about-asset-2.webp",
    "/images/aboutHeroAssets/about-asset-3.webp",
  ],
} = Astro.props;
---

<div class="work-slider">
  <div id="slideshow-track" class="work-slider__track">
    {slides.map((src, index) => (
      <div class="work-slider__slide">
        <img
          src={src}
          alt={`Featured Work ${index + 1}`}
          class="work-slider__img"
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .work-slider {
    position: relative;
    z-index: 9;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    user-select: none;
    margin: 0;
    padding: 0;
    background-color: var(--bg-page);
  }

  .work-slider__track {
    display: flex;
    width: 100%;
    height: 100%;
    will-change: transform;
    transition: transform 1000ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .work-slider__slide {
    width: 100%;
    height: 100%;
    flex: 0 0 100%;
    position: relative;
    overflow: hidden;
  }

  .work-slider__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }
</style>

<script>
  function setupSlideshow() {
    const track = document.getElementById("slideshow-track");
    if (!track) return;

    const slides = track.children;
    const totalSlides = slides.length;
    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goToSlide(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      (track as HTMLElement).style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    function startAutoPlay() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 5000);
    }

    startAutoPlay();
  }

  setupSlideshow();
  document.addEventListener("astro:page-load", setupSlideshow);
</script>